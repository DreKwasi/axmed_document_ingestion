#!/usr/bin/env bash
set -euo pipefail

# Enforce max 4 files per commit (contextual commits policy).
staged_count=$(git diff --cached --name-only --diff-filter=ACDMRT | wc -l | tr -d ' ')
if [[ "$staged_count" -gt 5 ]]; then
  echo "ERROR: Too many files staged ($staged_count > 5)." >&2
  echo "Policy: commit no more than 5 files per commit; split into contextual commits." >&2
  git diff --cached --name-only | sed 's/^/  - /' >&2
  exit 1
fi

# Correct simple violations before a commit, then enforce a clean lint result.
# Exit code 2 means no stack linter exists yet; allow bootstrap/configuration commits.
lint_status=0
bin/agent-lint --fix || lint_status=$?
if [[ "$lint_status" != 0 && "$lint_status" != 2 ]]; then exit "$lint_status"; fi
if [[ "$lint_status" == 2 ]]; then
  echo "WARN: no linter configured; bootstrap commit allowed." >&2
  exit 0
fi
bin/agent-lint
