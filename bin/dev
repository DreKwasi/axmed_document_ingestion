#!/usr/bin/env bash
# Start the local FastAPI and Vue development servers as one supervised process.
set -euo pipefail

workspace_root="$(cd "$(dirname "$0")/.." && pwd)"
api_port="${API_PORT:-8000}"
web_port="${WEB_PORT:-5173}"

cleanup() {
  for pid in "${api_pid:-}" "${web_pid:-}"; do
    if [[ -n "$pid" ]]; then
      pkill -TERM -P "$pid" 2>/dev/null || true
      kill "$pid" 2>/dev/null || true
    fi
  done
}
trap cleanup EXIT INT TERM

(cd "$workspace_root/backend" && set -a && source .env && set +a && uv run python -c 'from pathlib import Path; from app.config import get_config; from app.database import run_migrations; run_migrations(get_config().database_url, Path.cwd())')
(cd "$workspace_root/backend" && set -a && source .env && set +a && uv run uvicorn main:app --host 127.0.0.1 --port "$api_port" --reload) &
api_pid=$!
(cd "$workspace_root" && npm --prefix frontend run dev -- --host 127.0.0.1 --port "$web_port") &
web_pid=$!

wait "$api_pid" "$web_pid"
