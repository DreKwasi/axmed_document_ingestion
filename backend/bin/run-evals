#!/usr/bin/env bash
# Run evaluation regressions and persist a SQLite evaluation run from backend configuration.
set -euo pipefail

mode="live"
if [[ "${1:-}" == "--ocr" ]]; then
  mode="ocr"
elif [[ "${1:-}" == "--email" ]]; then
  mode="email"
elif [[ $# -ne 0 ]]; then
  echo "Usage: backend/bin/run-evals [--ocr|--email]" >&2
  exit 64
fi

backend_root="$(cd "$(dirname "$0")/.." && pwd)"
workspace_root="$(cd "$backend_root/.." && pwd)"
database_url_override="${DATABASE_URL:-}"

if [[ -f "$backend_root/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$backend_root/.env"
  set +a
fi
if [[ -n "$database_url_override" ]]; then
  export DATABASE_URL="$database_url_override"
fi
if [[ "$mode" == "ocr" ]]; then
  unset GEMINI_API_KEY
fi

cd "$backend_root"
env -u GEMINI_API_KEY uv run pytest tests/test_evaluations.py -q
EVAL_MODE="$mode" PYTHONPATH=. uv run python - <<'PY'
import json
import os
from pathlib import Path

from app.config import Config
from app.database import SessionLocal, run_migrations
from app.evaluations import run_live_email_evaluation, run_live_ocr_evaluation, run_live_pdf_evaluation, seed_evaluation_cases

settings = Config()
workspace_root = Path.cwd().parent
run_migrations(settings.database_url, workspace_root)
with SessionLocal() as session:
    seed_evaluation_cases(session, workspace_root / settings.golden_dataset_path)
    if os.environ["EVAL_MODE"] == "live":
        run = run_live_pdf_evaluation(
            session,
            project_root=workspace_root,
            golden_dataset_path=workspace_root / settings.golden_dataset_path,
            settings=settings,
        )
    elif os.environ["EVAL_MODE"] == "ocr":
        run = run_live_ocr_evaluation(
            session,
            golden_dataset_path=workspace_root / settings.golden_dataset_path,
            settings=settings,
        )
    elif os.environ["EVAL_MODE"] == "email":
        run = run_live_email_evaluation(
            session,
            golden_dataset_path=workspace_root / settings.golden_dataset_path,
            settings=settings,
        )
    else:
        run = run_live_pdf_evaluation(
            session,
            project_root=workspace_root,
            golden_dataset_path=workspace_root / settings.golden_dataset_path,
            settings=settings,
        )
    print(json.dumps({"id": run.id, "mode": run.execution_mode, "summary": json.loads(run.summary_json)}))
PY
