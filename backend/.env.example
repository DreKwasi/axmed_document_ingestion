# Google Gemini API key for live LangChain structured reasoning (gemini-3.1-flash-lite)
GEMINI_API_KEY=

# Optional: override default model (default is gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Modal PaddleOCR service endpoint and token for scanned images
AXMED_OCR_SERVICE_URL=
AXMED_OCR_SERVICE_TOKEN=

# Database configuration (defaults to local SQLite)
AXMED_DATABASE_URL=sqlite:///./data/app.db
AXMED_TASK_DATABASE_PATH=data/tasks.db
AXMED_UPLOAD_DIR=data/uploads
