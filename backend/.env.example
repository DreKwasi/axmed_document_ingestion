# Google Gemini API key for live LangChain structured reasoning (gemini-3.1-flash-lite)
GEMINI_API_KEY=

# Optional: override default model (default is gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REQUEST_TIMEOUT_SECONDS=60

# Optional: Modal PaddleOCR service endpoint override (defaults to https://andrewsboateng137--axmed-paddle-ocr.modal.run/ocr)
# OCR_SERVICE_URL=https://andrewsboateng137--axmed-paddle-ocr.modal.run/ocr
# OCR_SERVICE_TOKEN=

# Database and file upload configuration
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=data/uploads
# MAX_UPLOAD_BYTES=15728640  # 15 MB
